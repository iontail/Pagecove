{
  "name": "paperglim",
  "productName": "PaperGlim",
  "version": "0.1.6",
  "private": true,
  "description": "A personal workspace for reading papers with your AI.",
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "env -u ELECTRON_RUN_AS_NODE electron-vite dev --watch",
    "dev:renderer": "electron-vite dev --rendererOnly",
    "typecheck": "tsc --noEmit",
    "build": "npm run typecheck && electron-vite build",
    "start": "env -u ELECTRON_RUN_AS_NODE electron-vite preview",
    "test": "node --test tests/*.test.mjs",
    "dist:mac": "npm run build && electron-builder --mac --publish never",
    "icons": "node scripts/build-icons.mjs"
  },
  "packageManager": "npm@11.19.0",
  "engines": {
    "node": ">=24"
  },
  "dependencies": {
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "katex": "^0.19.1",
    "lucide-react": "^1.72.0",
    "pdfjs-dist": "^6.3.289",
    "radix-ui": "^1.8.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-markdown": "^10.1.0",
    "react-pdf": "^11.0.0",
    "rehype-katex": "^7.0.1",
    "remark-cjk-friendly": "^2.3.4",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "tailwind-merge": "^3.7.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.5",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "electron": "^45.3.2",
    "electron-builder": "^26.18.0",
    "electron-vite": "^6.0.0",
    "playwright": "^1.65.1",
    "tailwindcss": "^4.3.5",
    "typescript": "^7.0.2",
    "vite": "^8.3.8"
  },
  "author": "iontail",
  "homepage": "https://iontail.github.io/paperglim/",
  "repository": {
    "type": "git",
    "url": "https://github.com/iontail/PaperGlim.git"
  },
  "overrides": {
    "katex": "$katex"
  }
}
